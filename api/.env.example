# Non-secret configuration for the Taidy API (api/). Real secrets (Business
# Central / Factorial HR / Fabric credentials, SMTP if added later) live in
# the project root's own .env / config.json -- api/ never reads or stores
# them itself, it only calls into webapp/*.py, which already reads those.

# Set to "true" only once the API is served behind a reverse proxy that
# terminates HTTPS (matches this project's existing loopback-only,
# proxy-fronted deployment model). Leave unset/false for local http dev --
# a Secure cookie is silently dropped by the browser over plain http.
TAIDY_API_SECURE_COOKIES=false
