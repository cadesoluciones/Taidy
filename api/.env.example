# Non-secret configuration for the Taidy API (api/). Real secrets (Business
# Central / Factorial HR / Fabric credentials, SMTP if added later) live in
# the project root's own .env / config.json -- api/ never reads or stores
# them itself, it only calls into webapp/*.py, which already reads those.

# Set to "true" only once the API is served behind a reverse proxy that
# terminates HTTPS. Leave unset/false for local http dev and for the plain
# Docker/internal-network deployment described in the root README -- a
# Secure cookie is silently dropped by the browser over plain http.
TAIDY_API_SECURE_COOKIES=false

# Comma-separated CORS origin allowlist. Only matters for split-origin setups
# (frontend and API on different hosts/ports) -- never needed for the
# same-origin Docker deployment, where the API serves the built frontend
# itself. Defaults to the local Vite dev server origin if unset. Never "*".
TAIDY_CORS_ORIGINS=http://127.0.0.1:5173
