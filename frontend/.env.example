# Base URL of the NEXUS-BDB FastAPI backend (see ../api/). No secrets belong here --
# this file is bundled into the built frontend and is publicly readable.
#
# Only needed for local dev, where the Vite dev server (5173) and the API
# (8000) run on different ports. The Docker build leaves this unset on
# purpose: in production the API serves the built frontend itself (same
# origin), so requests should resolve relative to whatever host the browser
# used to reach the app, not a hardcoded one.
VITE_API_BASE_URL=http://127.0.0.1:8000
