# -----------------------------------------------------------------------------
# 📁 PYTHON: compiled files, environments, caches
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
*.pyd
*.pyo
*.pyc

# Virtual environments
.venv/
venv/

# Python dependency lock files (used by uv, pip-tools, etc.)
.requirements

# -----------------------------------------------------------------------------
# 📁 CDK & AWS: context, output, credentials
# -----------------------------------------------------------------------------
cdk.context.json
cdk.out/

# AWS credentials (never commit real ones!)
credentials.json
*.pem

# CloudFormation-related envs
.env.cloudformation

# -----------------------------------------------------------------------------
# 📁 NODE & JAVASCRIPT: dependencies, builds, logs
# -----------------------------------------------------------------------------
# package.json/package-lock.json are NOT ignored: frontend/ (the React
# migration) is a real Node project and both files must be tracked for a
# reproducible `npm install`. Only generated/local artifacts are ignored.
node_modules/
yarn-error.log
frontend/dist/
frontend/dist-ssr/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# Optional build artifacts (adjust for your CDK + JS tooling)
core/build/
core/**/*.c
core/**/*.so

# -----------------------------------------------------------------------------
# 🧪 TESTING & COVERAGE
# -----------------------------------------------------------------------------
.coverage
htmlcov/
.hypothesis/

# -----------------------------------------------------------------------------
# 🧑‍💻 IDEs & EDITORS
# -----------------------------------------------------------------------------
.idea/
.vscode/

# -----------------------------------------------------------------------------
# 📓 JUPYTER NOTEBOOKS
# -----------------------------------------------------------------------------
**/*.ipynb
**/.ipynb_checkpoints/
.ipynb_checkpoints/
!lab/*.ipynb

# -----------------------------------------------------------------------------
# 🧾 ENVIRONMENT FILES
# -----------------------------------------------------------------------------
.env*
!.env.example

# -----------------------------------------------------------------------------
# 🗃️ SYSTEM & OS FILES
# -----------------------------------------------------------------------------
*.DS_Store*

# -----------------------------------------------------------------------------
# 📦 LOCAL / PROJECT-SPECIFIC
# -----------------------------------------------------------------------------
local_data/
.env

exports/
.amazonq/

-----------
# Configuración local
config.json

# Exportaciones
exports_factorial/
exports_hubspot/

-----------

# Webapp: estado en tiempo de ejecución (no es código fuente)
webapp/schedules.json
webapp/run_history.json
webapp/audit.log
webapp/users.db
webapp/workflows.json
webapp/app_settings.json
webapp/fabric_catalog.json
webapp/fabric_catalog_live_cache.json
api/sessions.json

# Sync engine: caché persistida del fetch incremental (estado generado)
src/sync_engine/sync_cache/