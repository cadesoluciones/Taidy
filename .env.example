# Secretos y overrides de entorno para NEXUS-BDB. Copia este fichero a `.env` y
# rellena los valores reales -- `.env` está en .gitignore, nunca se commitea.
# El resto de la configuración (no secreta) vive en config.json.

# Business Central
BC_CLIENT_SECRET=tu-client-secret-aqui
# Nombre exacto del entorno de Business Central (tal cual aparece en la URL
# OData de BC, ej. PRODUCTION, SANDBOX_CADE, ...) -- tables.yaml es un único
# fichero compartido por todos los entornos y cada `url` lleva el placeholder
# `{ENVIRONMENT}`, sustituido por este valor al cargar. Solo afecta a Business
# Central; Fabric/Factorial/HubSpot no tienen concepto de entorno.
BC_ENVIRONMENT=PRODUCTION

# Factorial HR
FACTORIAL_API_KEY=tu-api-key-aqui
VERSION_API_FACTORIAL=2026-07-01
FACTORIAL_OVERLAP_DAYS=2      # opcional, días de solapamiento incremental global (default: 2)

# HubSpot CRM
HUBSPOT_API_KEY=tu-private-app-token-aqui   # token "pat-..." de una Private App de HubSpot

# Fabric OneLake (compartido por BC y Factorial)
FABRIC_CLIENT_SECRET=tu-fabric-secret-aqui
CONFIG_FILE=./config.json
FABRIC_UPLOAD_ENABLED=true   # opcional, fuerza la subida a Fabric aunque config.json la desactive

# Notificaciones por email (opcional, ver README "Notificaciones")
SMTP_USERNAME=tu-usuario-smtp
SMTP_PASSWORD=tu-password-smtp

# Resumen de actividad generado por IA (opcional -- "Inicio" siempre ofrece un
# resumen por plantilla sin ninguna de estas variables; esto solo activa la
# alternativa "IA generativa"). TAIDY_SUMMARY_PROVIDER: anthropic | openai | gemini
# TAIDY_SUMMARY_PROVIDER=anthropic
# ANTHROPIC_API_KEY=tu-api-key-aqui
# ANTHROPIC_MODEL=claude-3-5-haiku-latest     # opcional, este es el valor por defecto
# OPENAI_API_KEY=tu-api-key-aqui
# OPENAI_MODEL=gpt-4o-mini                    # opcional, este es el valor por defecto
# OPENAI_BASE_URL=http://localhost:11434/v1   # opcional: apunta a un modelo local
#                                              # compatible con la API de OpenAI (Ollama,
#                                              # LM Studio, vLLM, ...) en vez de OpenAI
# GEMINI_API_KEY=tu-api-key-aqui
# GEMINI_MODEL=gemini-1.5-flash               # opcional, este es el valor por defecto
